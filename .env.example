# Copy to .env and fill in. Never commit .env.
DB_SERVER=yourserver.database.windows.net
DB_NAME=warehouse
DB_USER=etl_user
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server

SHOPIFY_API_VERSION=2020-10

ALERT_FROM=pipeline@example.com
ALERT_TO=oncall@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Incremental load: delete-and-reload this many days of overlap each run
OVERLAP_DAYS=10
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=20
